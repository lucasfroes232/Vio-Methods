# syntax=docker/dockerfile:1
# OKVIS2 (ROS 2 oficial; README dos autores documenta Ubuntu 24.04 / Jazzy) em ARM64.
FROM ros:jazzy-ros-base
ARG ROS_DISTRO=jazzy
ARG OKVIS_REF=main
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=jazzy
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git nano tmux \
      python3-colcon-common-extensions python3-psutil python3-numpy python3-opencv \
      libeigen3-dev libboost-all-dev libopencv-dev libpcl-dev \
      libsuitesparse-dev libgoogle-glog-dev libgflags-dev libatlas-base-dev \
      ros-jazzy-cv-bridge ros-jazzy-image-transport ros-jazzy-message-filters \
      ros-jazzy-pcl-conversions ros-jazzy-pcl-msgs ros-jazzy-eigen3-cmake-module \
      ros-jazzy-ament-cmake-python ros-jazzy-visualization-msgs \
      ros-jazzy-rosbag2-cpp ros-jazzy-rosbag2-storage-default-plugins ros-jazzy-ros2bag \
      ros-jazzy-launch-testing-ros ros-jazzy-rmw-cyclonedds-cpp \
 && rm -rf /var/lib/apt/lists/*

# Submodulos: ceres, brisk, DBoW2, opengv (o OKVIS2 compila o proprio ceres)
RUN mkdir -p /opt/okvis_ws/src && cd /opt/okvis_ws/src \
 && git clone --recurse-submodules --branch ${OKVIS_REF} https://github.com/ethz-mrl/okvis2.git okvis2 \
 && git -C okvis2 log -1 --format='OKVIS2 commit: %H' | tee /opt/okvis_commit.txt
# Sem LibTorch (USE_NN=OFF), sem RealSense, sem apps de demonstracao.
# MAKEFLAGS limita a memoria do compilador no runner.
RUN . /opt/ros/jazzy/setup.sh && cd /opt/okvis_ws \
 && MAKEFLAGS="-j3" colcon build --executor sequential --event-handlers console_cohesion+ \
      --packages-select okvis \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_ROS2=ON -DUSE_NN=OFF \
                   -DHAVE_LIBREALSENSE=OFF -DBUILD_APPS=OFF -DBUILD_TESTS=OFF \
 && rm -rf build log

COPY docker/entrypoint.sh /entrypoint.sh
COPY scripts/ /opt/limo_vio/scripts/
COPY tools/   /opt/limo_vio/tools/
COPY configs/ /opt/limo_vio/configs/
RUN chmod +x /entrypoint.sh /opt/limo_vio/scripts/*.sh /opt/limo_vio/tools/*.py
ENV PATH=/opt/limo_vio/scripts:/opt/limo_vio/tools:${PATH}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
