# syntax=docker/dockerfile:1
# VINS-Fusion (sucessor do VINS-Mono, mesmo nucleo) em ROS 2 Humble, ARM64.
# ATENCAO: NAO e port oficial. Usa a porta da comunidade the-ninth-moon/VINS-Fusion-ROS2-humble-arm
# (autor relata testes em Jetson Orin/Nano; modo estereo+IMU documentado, mono+IMU so por arquivo de exemplo).
FROM ros:humble-ros-base
ARG ROS_DISTRO=humble
ARG VINSF_REPO=https://github.com/the-ninth-moon/VINS-Fusion-ROS2-humble-arm.git
ARG VINSF_REF=master
ARG CERES_REF=2.1.0
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=humble
# libceres-dev (2.0 do apt) NAO e instalado: a porta foi testada com Ceres 2.1.0, compilado abaixo.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git nano tmux \
      python3-colcon-common-extensions python3-psutil python3-numpy \
      libeigen3-dev libboost-all-dev libopencv-dev \
      libsuitesparse-dev libgoogle-glog-dev libgflags-dev libatlas-base-dev \
      ros-humble-cv-bridge ros-humble-image-transport \
      ros-humble-tf2-ros ros-humble-tf2-geometry-msgs \
      ros-humble-ros2bag ros-humble-rosbag2-storage-default-plugins \
      ros-humble-rmw-cyclonedds-cpp \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${CERES_REF} https://github.com/ceres-solver/ceres-solver.git /tmp/ceres \
 && cmake -S /tmp/ceres -B /tmp/ceres/build -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARKS=OFF \
 && cmake --build /tmp/ceres/build -j3 && cmake --install /tmp/ceres/build && rm -rf /tmp/ceres

RUN mkdir -p /opt/vins_ws/src && cd /opt/vins_ws/src \
 && git clone ${VINSF_REPO} VINS-Fusion-ROS2 \
 && cd VINS-Fusion-ROS2 && git checkout ${VINSF_REF} && git log -1 --format='VINSF commit: %H' | tee /opt/vinsf_commit.txt
# CPU apenas: o OpenCV do apt nao tem CUDA, entao desliga o macro de GPU (falha o build se o arquivo mudou)
RUN F=/opt/vins_ws/src/VINS-Fusion-ROS2/vins/src/featureTracker/feature_tracker.h \
 && sed -i 's|^#define GPU_MODE 1|// #define GPU_MODE 1|' $F && grep -q '^// #define GPU_MODE 1' $F
RUN . /opt/ros/humble/setup.sh && cd /opt/vins_ws \
 && MAKEFLAGS="-j3" colcon build --executor sequential --event-handlers console_cohesion+ \
      --packages-select camera_models vins \
      --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && rm -rf build log

COPY docker/entrypoint.sh /entrypoint.sh
COPY scripts/ /opt/limo_vio/scripts/
COPY tools/   /opt/limo_vio/tools/
COPY configs/ /opt/limo_vio/configs/
RUN chmod +x /entrypoint.sh /opt/limo_vio/scripts/*.sh /opt/limo_vio/tools/*.py
ENV PATH=/opt/limo_vio/scripts:/opt/limo_vio/tools:${PATH}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
