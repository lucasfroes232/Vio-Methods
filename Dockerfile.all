# syntax=docker/dockerfile:1
# Imagem UNICA ROS 2 (ARM64; ARG ROS_DISTRO = jazzy | humble): OpenVINS + OKVIS2 + VINS-Fusion + drivers do Limo + ferramentas de experimento.
# Cada componente e compilado isolado; veja o resultado com:  docker run --rm IMAGE status.sh
ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base
ARG ROS_DISTRO
ARG OV_REF=master
ARG OKVIS_REF=main
ARG VINSF_REPO=https://github.com/the-ninth-moon/VINS-Fusion-ROS2-humble-arm.git
ARG VINSF_REF=master
ARG CERES_REF=2.1.0
ARG LIMO_REF=humble
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=${ROS_DISTRO}
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git nano tmux v4l-utils \
      python3-colcon-common-extensions python3-psutil python3-numpy python3-opencv \
      libeigen3-dev libceres-dev libboost-all-dev libopencv-dev libpcl-dev \
      libsuitesparse-dev libgoogle-glog-dev libgflags-dev libatlas-base-dev \
      ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-image-transport ros-${ROS_DISTRO}-message-filters \
      ros-${ROS_DISTRO}-pcl-conversions ros-${ROS_DISTRO}-pcl-msgs ros-${ROS_DISTRO}-eigen3-cmake-module \
      ros-${ROS_DISTRO}-ament-cmake-python ros-${ROS_DISTRO}-visualization-msgs \
      ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-tf2-geometry-msgs \
      ros-${ROS_DISTRO}-rosbag2-cpp ros-${ROS_DISTRO}-rosbag2-storage-default-plugins ros-${ROS_DISTRO}-ros2bag \
      ros-${ROS_DISTRO}-launch-testing-ros ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
      ros-${ROS_DISTRO}-v4l2-camera ros-${ROS_DISTRO}-turtlesim \
 && rm -rf /var/lib/apt/lists/*

COPY docker/build_*.sh docker/fix_includes.py /usr/local/bin/
RUN chmod +x /usr/local/bin/build_*.sh /usr/local/bin/fix_includes.py
RUN build_limo.sh
RUN build_openvins.sh
RUN build_okvis2.sh
RUN build_vinsfusion.sh
# Falha o build so se NENHUM metodo VIO compilou; o CI mostra o status de cada um acima.
RUN for f in /opt/status/*; do case $f in *.log|*.commit) ;; *) echo "$(basename $f): $(cat $f)";; esac; done \
 && cat /opt/status/openvins /opt/status/okvis2 /opt/status/vinsfusion | grep -q OK

COPY docker/entrypoint.sh /entrypoint.sh
COPY scripts/ /opt/limo_vio/scripts/
COPY tools/   /opt/limo_vio/tools/
COPY configs/ /opt/limo_vio/configs/
RUN chmod +x /entrypoint.sh /opt/limo_vio/scripts/*.sh /opt/limo_vio/tools/*.py
ENV PATH=/opt/limo_vio/scripts:/opt/limo_vio/tools:${PATH}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
