# syntax=docker/dockerfile:1
# OpenVINS (ROS 2 oficial) em ROS 2 Humble, ARM64 (Jetson Orin Nano / Limo).
FROM ros:humble-ros-base
ARG ROS_DISTRO=humble
ARG OV_REF=master
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=humble
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git nano tmux \
      python3-pip python3-colcon-common-extensions python3-psutil python3-numpy \
      libeigen3-dev libceres-dev libboost-all-dev libopencv-dev \
      libsuitesparse-dev libgoogle-glog-dev libgflags-dev libatlas-base-dev \
      ros-humble-cv-bridge ros-humble-image-transport \
      ros-humble-tf2-ros ros-humble-tf2-geometry-msgs \
      ros-humble-ros2bag ros-humble-rosbag2-storage-default-plugins \
      ros-humble-rmw-cyclonedds-cpp \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/ov_ws/src && cd /opt/ov_ws/src \
 && git clone --depth 1 --branch ${OV_REF} https://github.com/rpng/open_vins.git \
 && git -C open_vins log -1 --format='OpenVINS commit: %H' | tee /opt/ov_commit.txt
RUN . /opt/ros/humble/setup.sh && cd /opt/ov_ws \
 && colcon build --executor sequential --event-handlers console_cohesion+ \
      --packages-select ov_core ov_init ov_msckf \
      --cmake-args -DCMAKE_BUILD_TYPE=Release \
 && rm -rf build log

COPY docker/entrypoint.sh /entrypoint.sh
COPY scripts/ /opt/limo_vio/scripts/
COPY tools/   /opt/limo_vio/tools/
COPY configs/ /opt/limo_vio/configs/
RUN chmod +x /entrypoint.sh /opt/limo_vio/scripts/*.sh /opt/limo_vio/tools/*.py
ENV PATH=/opt/limo_vio/scripts:/opt/limo_vio/tools:${PATH}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
